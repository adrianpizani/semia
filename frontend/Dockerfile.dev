# Dockerfile de desarrollo (hot reload). Producción: ./Dockerfile
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

EXPOSE 3000

ENV NODE_ENV=development
# -H 0.0.0.0: nginx en otro container tiene que llegar al puerto 3000.
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0", "-p", "3000"]
