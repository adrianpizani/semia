# ===== WALICHO - variables de entorno =====
# Copia este archivo a `.env` y completá los valores para tu entorno.

# --- Backend ---
# Secreto para firmar/verificar los JWT. DEBE ser el mismo en backend y frontend.
# En producción usá un valor largo y aleatorio (ej: `openssl rand -hex 32`).
SECRET_KEY=dev-secret-key-cambiar-en-produccion

# Cookie de sesión: Secure=true solo con HTTPS (producción).
COOKIE_SECURE=false

# Duración del token en minutos (default 720 = 12h).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Conexión a la base de datos (PostgreSQL/PostGIS).
# En Docker apunta al servicio 'db'; locamente podés usar localhost:5433.
DATABASE_URL=postgresql+asyncpg://root:root@db/pba_dashboard

# Usuario admin inicial (se crea con `python -m app.scripts.create_admin`).
ADMIN_EMAIL=admin@walicho.com
ADMIN_PASSWORD=admin123

# --- Frontend ---
# Mismo secreto que SECRET_KEY: lo usa proxy.ts para validar el JWT en el borde.
AUTH_SECRET=dev-secret-key-cambiar-en-produccion

# URL del backend para las rewrites de Next (dentro de Docker usa el nombre del servicio).
BACKEND_URL=http://backend:8000