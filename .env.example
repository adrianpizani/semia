# ===== WALICHO - variables de entorno =====
# Copia este archivo a `.env` y completá los valores para tu entorno.
#
# En docker compose DEV (./docker-compose.yml) las defaults abajo sirven.
# En docker compose PROD (./docker-compose.prod.yml) SOBRESCRIBIR:
#   - POSTGRES_USER / POSTGRES_PASSWORD con valores fuertes (no root/root)
#   - DATABASE_URL apuntando al servicio 'db' con las nuevas credenciales
#   - COOKIE_SECURE=true (requerido detrás de HTTPS)
#   - SECRET_KEY / AUTH_SECRET con `openssl rand -hex 32`

# --- Postgres (contenedor 'db' del compose) ---
# Las credenciales que inicializan el contenedor la primera vez.
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=pba_dashboard

# --- Backend ---
# Secreto para firmar/verificar los JWT. DEBE ser el mismo en backend y frontend.
# En producción usá un valor largo y aleatorio (ej: `openssl rand -hex 32`).
SECRET_KEY=dev-secret-key-cambiar-en-produccion

# Cookie de sesión: Secure=true solo con HTTPS (producción detrás de nginx).
# En prod con docker-compose.prod.yml se fuerza a "true" por env.
COOKIE_SECURE=false

# Duración del token en minutos (default 720 = 12h).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Workers de uvicorn (default 2). En t3.micro no pasar de 2; con 2 GB se puede 4.
UVICORN_WORKERS=2

# Conexión a la base de datos (PostgreSQL/PostGIS).
# En Docker apunta al servicio 'db'; localmente podés usar localhost:5433.
# IMPORTANTE: POSTGRES_USER/POSTGRES_PASSWORD arriba deben matchear esto.
DATABASE_URL=postgresql+asyncpg://root:root@db/pba_dashboard

# Usuario admin inicial (se crea con `python -m app.scripts.create_admin`).
ADMIN_EMAIL=admin@walicho.com
ADMIN_PASSWORD=admin123

# --- Frontend ---
# Mismo secreto que SECRET_KEY: lo usa proxy.ts para validar el JWT en el borde.
AUTH_SECRET=dev-secret-key-cambiar-en-produccion

# URL del backend para las rewrites de Next.
#   DEV:    http://backend:8000     (red interna de Docker)
#   LOCAL:  http://localhost:8000   (corriendo el backend fuera de Docker)
#   PROD:   http://backend:8000     (nginx enruta /api/* al backend en la red interna)
BACKEND_URL=http://backend:8000

# NEXT_PUBLIC_API_BASE_URL se EMBEBE en el bundle de JS al hacer `next build`.
# Dejar vacío: el browser llama a `/api/v1` (rewrites de Next o nginx, mismo origen).
# Si alguna vez el browser habla DIRECTO con el backend (no recomendado, cookies CORS):
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=
